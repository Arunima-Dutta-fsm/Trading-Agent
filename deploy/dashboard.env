# Private live dashboard on the server. NO secrets here: the dashboard runs read-only and
# never contacts the broker, so it needs no keys or PINs. Installed to /etc/aaba/dashboard.env.
AABA_READ_ONLY=1
AABA_SKIP_DOTENV=1
AABA_DASHBOARD_REFRESH_SECONDS=60
AABA_DATA_DIR=/var/lib/aaba/data
AABA_DB_PATH=/var/lib/aaba/data/aaba.db
AABA_MODEL_RUN_DIR=/var/lib/aaba/model-run
AABA_REPORT_DIR=/var/lib/aaba/reports
AABA_LOG_DIR=/var/log/aaba
