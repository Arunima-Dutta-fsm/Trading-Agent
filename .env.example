# Copy this file to .env and fill in your own values. Never commit .env.
# Lines starting with # are comments.

# ---------------------------------------------------------------- Alpaca PAPER accounts
# One paper account per student. Create the keys in each student's own Alpaca
# dashboard (Paper Trading > API keys). Paper key IDs normally start with "PK".
# The code always uses https://paper-api.alpaca.markets; there is no live option.
STUDENT1_ALPACA_API_KEY=
STUDENT1_ALPACA_SECRET_KEY=
STUDENT2_ALPACA_API_KEY=
STUDENT2_ALPACA_SECRET_KEY=
STUDENT3_ALPACA_API_KEY=
STUDENT3_ALPACA_SECRET_KEY=

# Optional but recommended: the account number shown in each Alpaca paper dashboard
# (e.g. PA3XXXXXXXXX). If set, orders are blocked when the keys open a different account.
STUDENT1_ALPACA_ACCOUNT_NUMBER=
STUDENT2_ALPACA_ACCOUNT_NUMBER=
STUDENT3_ALPACA_ACCOUNT_NUMBER=

# Optional: separate keys used only for market data. If empty, Student 1's keys are used.
DATA_ALPACA_API_KEY=
DATA_ALPACA_SECRET_KEY=

# ---------------------------------------------------------------- SELL approval PINs
# Each student picks their own PIN (at least 6 characters) and keeps it private.
# A SELL can only be approved with the owning student's PIN.
STUDENT1_APPROVAL_PIN=
STUDENT2_APPROVAL_PIN=
STUDENT3_APPROVAL_PIN=

# PIN for dashboard actions that change things (order runs, settings). At least 6 characters.
DASHBOARD_ADMIN_PIN=

# ---------------------------------------------------------------- order switch
# Second safety switch. Real paper orders are sent only when this is true AND the run
# mode is "paper". Keep false until analysis and dry_run runs look right.
ENABLE_PAPER_ORDERS=false

# ---------------------------------------------------------------- LLM (one shared model)
# groq | openrouter | ollama | openai | openai_compatible
LLM_PROVIDER=groq
# The provider's own model id. Check the provider's model list; models get retired.
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
# only for openai_compatible
LLM_BASE_URL=
LLM_API_KEY=
# Optional fallback model, used only if the primary cannot be set up
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_MODEL=
# Seconds to wait for one model reply, and retries. Raise LLM_TIMEOUT for slow local models.
LLM_TIMEOUT=120
LLM_MAX_RETRIES=2
# Example for a local Ollama model (needs a tool-calling model, 7B or larger works best):
#   LLM_PROVIDER=openai_compatible
#   LLM_MODEL=qwen3:8b
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_API_KEY=ollama
# Check any model with:  python main.py llm-test

# ---------------------------------------------------------------- optional extras
# Earnings calendar (free key from finnhub.io). Without it the earnings check is "unknown".
FINNHUB_API_KEY=
# Show CrewAI's step-by-step output in the terminal
CREW_VERBOSE=false
